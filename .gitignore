# ===== Java / Maven =====
backend/target/
*.class
*.jar
*.war

# ===== SQLite database (auto-created on startup, do not upload) =====
backend/data/*.db
backend/data/*.db-journal
backend/data/*.db-wal
backend/data/*.db-shm

# ===== User uploaded files (generated at runtime, do not upload) =====
backend/uploads/*
!backend/uploads/.gitkeep

# ===== Node.js =====
frontend/node_modules/
frontend/dist/
frontend/.vite/

# ===== IDE =====
.idea/
.vscode/
*.iml
*.ipr
*.iws

# ===== Logs =====
*.log
logs/

# ===== System files =====
.DS_Store
Thumbs.db
desktop.ini

# ===== Python test cache =====
tests/__pycache__/
tests/.pytest_cache/
*.pyc
